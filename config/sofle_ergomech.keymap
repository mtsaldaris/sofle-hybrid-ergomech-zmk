#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        raise_layer {
            if-layers = <1 1>;
            then-layer = <1>;
        };

        media_layer {
            if-layers = <2>;
            then-layer = <2>;
        };

        code_layer {
            if-layers = <3>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp GRAVE       &kp N1              &kp N2          &kp N3            &kp N4          &kp N5     &kp N6     &kp N7           &kp N8             &kp N9           &kp N0                  &none
&kp ESC         &kp Q               &kp W           &kp E             &kp R           &kp T      &kp Y      &kp U            &kp I              &kp O            &kp P                   &none
&kp TAB         &mt LEFT_CONTROL A  &mt LEFT_ALT S  &mt LEFT_SHIFT D  &mt LEFT_GUI F  &kp G      &kp H      &mt RIGHT_GUI J  &mt RIGHT_SHIFT K  &mt RIGHT_ALT L  &mt SEMI RIGHT_CONTROL  &kp SQT
&kp LEFT_SHIFT  &kp Z               &kp X           &kp C             &kp V           &kp B      &kp N      &kp M            &kp COMMA          &kp DOT          &kp FSLH                &kp LEFT_CONTROL
&kp C_MUTE      &none               &mo 2           &mo 1             &kp TAB         &kp SPACE  &kp ENTER  &kp BACKSPACE    &mo 3              &mo 2            &none
                                                                                                 &kp ENTER  &kp RIGHT        &kp UP_ARROW       &kp LEFT         &kp DOWN
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            label = "raise";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&studio_unlock  &kp F1      &kp F2     &kp F3      &kp F4       &kp F5  &kp F6    &kp F7         &kp F8    &kp F9     &kp F10  &kp F11
&none           &trans      &trans     &trans      &trans       &trans  &kp HOME  &kp PAGE_UP    &kp UP    &trans     &trans   &kp F12
&trans          &trans      &trans     &trans      &trans       &trans  &kp END   &kp LEFT       &kp DOWN  &kp RIGHT  &trans   &trans
&trans          &kp K_UNDO  &kp K_CUT  &kp K_COPY  &kp K_PASTE  &trans  &trans    &kp PAGE_DOWN  &trans    &trans     &trans   &trans
&trans          &trans      &trans     &trans      &trans       &trans  &trans    &trans         &trans    &trans     &trans
                                                                        &kp A     &kp B          &kp C     &kp D      &kp E
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        media {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            label = "media";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4     &none       &none         &none             &none       &none        &kp LC(LG(Q))
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF  &none       &kp C_VOL_UP  &none             &none       &none        &kp LS(LG(NUMBER_4))
&none              &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none            &kp C_MUTE  &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT  &none        &none
&none              &none            &none            &none            &none            &none            &none       &kp C_VOL_DN  &none             &none       &none        &none
&rgb_ug RGB_TOG    &bootloader      &none            &none            &none            &none            &none       &none         &none             &none       &bootloader
                                                                                                        &kp A       &kp B         &kp C             &kp D       &kp E
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        code {
            bindings = <
&trans  &trans    &trans  &trans    &trans    &trans         &trans     &trans                &trans     &trans    &trans  &trans
&trans  &trans    &trans  &trans    &trans    &kp SQT        &kp PLUS   &kp NON_US_BACKSLASH  &kp SLASH  &trans    &trans  &trans
&trans  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT      &kp UNDER  &kp LBRC              &kp LBKT   &kp LPAR  &trans  &trans
&trans  &trans    &trans  &trans    &trans    &kp SEMICOLON  &kp EQUAL  &kp RBRC              &kp RBKT   &kp RPAR  &trans  &trans
&trans  &trans    &trans  &trans    &trans    &trans         &trans     &trans                &trans     &trans    &trans
                                                             &trans     &trans                &trans     &trans    &trans
            >;

            label = "code";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
